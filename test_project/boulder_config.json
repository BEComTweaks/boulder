{
  "project": {
    "folders": {
      "behaviour_pack": "bp",
      "resource_pack": "rp"
    }
  },
  "manifest": {
    "name": "Terracotta Rotation Wrench",
    "description": "A wrench that can rotate glazed terracotta blocks.",
    "version": "1.0.0",
    "min_engine_version": "1.21.0",
    "link-packs": true,
    "generate-for-build": true,
    "dependencies": {
      "behaviour_pack": [
        {
          "module_name": "@minecraft/server",
          "version": "1.16.0"
        }
      ],
      "resource_pack": []
    },
    "modules": {
      "behaviour_pack": [
        {
          "language": "javascript",
          "type": "script",
          "description": "Terracotta Rotation Wrench Scripting APIs Features",
          "version": [1, 0, 0],
          "entry": "scripts/main.js"
        }
      ],
      "resource_pack": []
    }
  },
  "hooks": {
    "remote": [
      {
        "repo": "https://github.com/BEComTweaks/boulder_hooks",
        "name": "PAPI's favourite commands"
      }
    ],
    "local": []
  }
}
